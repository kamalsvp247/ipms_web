<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Scan for configuration changes every 60 seconds -->
    <property name="LOG_DIR" value="logs"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="LOG_PATTERN_SHORT" value="%d{HH:mm:ss} [%thread] %-5level %msg%n"/>

    <!-- Async appender for better performance under high load -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="CONSOLE"/>
    </appender>

    <!-- Console output: concise, colored, without excessive detail -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN_SHORT}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- File appender: all logs with full detail -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/ivac-booking.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/ivac-booking-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- API debug logs: per-phone, compact, 1-3 lines per request -->
    <appender name="API_DEBUG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/api-debug.log</file>
        <encoder>
            <pattern>%msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/api-debug-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- Separate logger for API debug (no parent logger interference) -->
    <logger name="com.ivac.booking.util.ApiLogger" level="DEBUG" additivity="false">
        <appender-ref ref="API_DEBUG"/>
    </logger>

    <!-- Worker thread logs -->
    <logger name="com.ivac.booking.worker" level="INFO"/>

    <!-- OkHttpClient connection logs (verbose for debugging connection issues) -->
    <logger name="okhttp3" level="WARN"/>
    <logger name="okhttp3.internal" level="WARN"/>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="ASYNC_CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
